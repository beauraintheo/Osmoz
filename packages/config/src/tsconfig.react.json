{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite-plus/client"],
    "paths": {
      "@/*": ["${configDir}/src/*"]
    }
  },
  "include": ["${configDir}/src", "${configDir}/vite.config.ts"]
}
