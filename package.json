{
  "name": "osmoz",
  "private": true,
  "type": "module",
  "scripts": {
    "app": "node packages/scripts/src/pick.ts",
    "dev": "node packages/scripts/src/main.ts dev",
    "build": "node packages/scripts/src/main.ts build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "check-types": "tsc --noEmit && vp run -F '!osmoz' check-types",
    "test": "vp run -F '!osmoz' test",
    "test:coverage": "vp run -F '!osmoz' test:coverage",
    "validate": "node packages/scripts/src/main.ts validate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@osmoz/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint-plugin-perfectionist": "^5.13.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
