{
  "name": "osmoz",
  "private": true,
  "type": "module",
  "scripts": {
    "app": "node packages/scripts/src/pick.ts",
    "dev": "node packages/scripts/src/main.ts dev",
    "build": "node packages/scripts/src/main.ts build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "check-types": "tsc --noEmit && tsc --noEmit -p .storybook && vp run -F '!osmoz' check-types",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "test": "vp run -F '!osmoz' test",
    "test:coverage": "vp run -F '!osmoz' test:coverage",
    "test:stories": "vp test run --coverage",
    "validate": "node packages/scripts/src/main.ts validate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@osmoz/brand": "workspace:*",
    "@osmoz/config": "workspace:*",
    "@osmoz/preferences": "workspace:*",
    "@osmoz/theme": "workspace:*",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "eslint-plugin-perfectionist": "^5.13.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "catalog:",
    "storybook": "10.6.7",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
